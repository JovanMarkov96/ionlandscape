{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JovanMarkov96/ionlandscape/schemas/person.schema.json",
  "title": "Ion Landscape Person Profile (v2)",
  "description": "YAML frontmatter schema for content/people/*.md. Enums sourced from schemas/vocabularies.yaml.",
  "vocab_source": "schemas/vocabularies.yaml",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "name",
    "location",
    "group_type",
    "platforms",
    "active"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "description": "NNN-slug. Three-digit zero-padded sequence, hyphenated lowercase slug.",
      "pattern": "^\\d{3}-[a-z0-9-]+$"
    },
    "entity_type": {
      "const": "person"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "sort_name": {
      "type": "string",
      "description": "Sort key, conventionally 'Last, First'."
    },
    "location": {
      "type": "object",
      "required": [
        "city",
        "country"
      ],
      "additionalProperties": false,
      "properties": {
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "precision": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "building",
            "campus",
            "city",
            "inherited",
            "none",
            null
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "geocoded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "geocode_source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "current_position": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "institution",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "institution": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "since_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1950,
          "maximum": 2099
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "confirmed",
            "openalex_inferred",
            "stale",
            "ambiguous",
            null
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "group_type": {
      "type": "string",
      "enum": [
        "experimental",
        "theory",
        "mixed"
      ]
    },
    "active": {
      "type": "string",
      "description": "Activity status. 'unknown' is acceptable but discouraged.",
      "enum": [
        "active",
        "retired",
        "deceased",
        "unknown"
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platforms": {
      "type": "array",
      "description": "Physical platforms the researcher works with. See vocabularies.yaml.",
      "items": {
        "type": "string",
        "enum": [
          "trapped_ion",
          "neutral_atom",
          "rydberg_array",
          "superconducting",
          "nv_center",
          "color_center",
          "photonic",
          "trapped_molecule",
          "topological",
          "silicon_spin",
          "quantum_dot",
          "cavity_qed_hybrid"
        ]
      }
    },
    "applications": {
      "type": "array",
      "description": "Research-application axis. Required (non-empty) when group_type is experimental or mixed.",
      "items": {
        "type": "string",
        "enum": [
          "computing",
          "simulation",
          "networking",
          "sensing_metrology",
          "optical_clocks",
          "fundamental_physics",
          "software_control"
        ]
      }
    },
    "ion_species": {
      "type": "array",
      "description": "Ion species worked with (when platforms includes trapped_ion). Accepts isotope prefix and small molecular formulas. Examples: Ca+, Sr+, Yb171+, 9Be+, HD+, SiO+, ThO+.",
      "items": {
        "type": "string",
        "pattern": "^\\d*[A-Z][a-zA-Z0-9]*\\+?$"
      }
    },
    "atomic_species": {
      "type": "array",
      "description": "Atomic species (when platforms includes neutral_atom or rydberg_array). Examples: Rb, Cs, Sr, Yb, Dy.",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][a-z]?\\d*$"
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "degree"
        ],
        "additionalProperties": false,
        "properties": {
          "degree": {
            "type": "string"
          },
          "institution": {
            "type": [
              "string",
              "null"
            ]
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1950,
            "maximum": 2099
          },
          "advisor": {
            "type": [
              "string",
              "null"
            ]
          },
          "advisor_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{3}-[a-z0-9-]+$"
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "confirmed",
              "academictree_only",
              "not_found",
              "ambiguous",
              null
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      }
    },
    "postdocs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "institution"
        ],
        "additionalProperties": false,
        "properties": {
          "institution": {
            "type": "string"
          },
          "advisor": {
            "type": [
              "string",
              "null"
            ]
          },
          "advisor_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{3}-[a-z0-9-]+$"
          },
          "years": {
            "type": [
              "string",
              "null"
            ]
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "confirmed",
              "academictree_only",
              "not_found",
              "ambiguous",
              null
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      }
    },
    "thesis": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "link": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      },
      "properties": {
        "homepage": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "group_page": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "google_scholar": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "orcid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
        },
        "institution_profile": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "keywords": {
      "type": "array",
      "description": "Free-form research keywords. Use sparingly; prefer applications + platforms when possible.",
      "items": {
        "type": "string"
      }
    },
    "affiliations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "company",
              "institution",
              "non_profit",
              "consultancy",
              "advisory_board",
              "editorial",
              "other"
            ]
          },
          "person_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "entity_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reference to a c-prefixed company id or i-prefixed institution id when known."
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      }
    },
    "key_papers": {
      "type": "array",
      "description": "Up to 10 representative papers. Not a full bibliography.",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1950,
            "maximum": 2099
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "first_author",
              "senior_author",
              "corresponding",
              "co_author",
              null
            ]
          }
        }
      }
    },
    "metrics": {
      "type": [
        "object",
        "null"
      ],
      "description": "Bibliometric snapshot, populated by API enrichment.",
      "additionalProperties": false,
      "properties": {
        "h_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "citation_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "publication_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "google_scholar",
            "scopus",
            "orcid_works",
            "semantic_scholar",
            "openalex",
            null
          ]
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "lineage_check": {
      "type": [
        "object",
        "null"
      ],
      "description": "Flags indicating whether advisor / postdoc relationships have been verified against authoritative sources.",
      "additionalProperties": false,
      "properties": {
        "advisor_verified": {
          "type": "boolean"
        },
        "postdoc_verified": {
          "type": "boolean"
        },
        "last_checked": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "last_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Date of last manual or automated re-verification of the entry against authoritative sources."
    },
    "verification_source_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Count of distinct authoritative sources that back populated fields."
    },
    "stub": {
      "type": "boolean",
      "description": "True if this entry exists only to satisfy a relationship graph reference; minimal fields populated."
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  },
  "allOf": [
    {
      "description": "If group_type is experimental or mixed, applications must be a non-empty array.",
      "if": {
        "properties": {
          "group_type": {
            "enum": [
              "experimental",
              "mixed"
            ]
          }
        },
        "required": [
          "group_type"
        ]
      },
      "then": {
        "properties": {
          "applications": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "applications"
        ]
      }
    }
  ]
}
